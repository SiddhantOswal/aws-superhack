{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "sourceMap": true,

    // ✅ Added: treat whole repo as one root
    "baseUrl": ".",
    "rootDir": ".",

    // ✅ Added: path aliases for clean imports
    "paths": {
      "@src/*": ["src/*"],
      "@config/*": ["src/config/*"],
      "@utils/*": ["src/utils/*"]
    }
  },

  // ✅ Include all source folders
  "include": ["src/**/*", "lambdas/**/*", "scripts/**/*"],

  // ✅ Keep your existing project references
  "references": [
    { "path": "./lambdas/approve-action" },
    { "path": "./lambdas/athena-bootstrap" },
    { "path": "./lambdas/draft-change-order" },
    { "path": "./lambdas/policy-evaluator" },
    { "path": "./lambdas/qbr-pdf" },
    { "path": "./lambdas/shelfware-report" },
    { "path": "./lambdas/underbilling-report" }
  ]
}
